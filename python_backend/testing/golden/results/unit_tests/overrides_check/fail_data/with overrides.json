  "text_box_data": {
   "u3a81": {
    "content": "End this year festively and in style? With a view of no less than five historic canals in Amsterdam, a fantastic interior and a team of chefs that only work with the freshest quality products, The Harbour Club in Amsterdam South is the perfect location for your end-of-year event!\n",
    "identifier": "u3a81",
    "page_id": "u2215",
    "page_name": "1"
   },
   "u3a98": {
    "content": "Choose for an extensive 6- or 8-course walking dinner followed by a well-deserved winter drink with your colleagues! At The Harbour Club Amsterdam Zuid, our team ensures that everything is taken care of down to the last detail.\n",
    "identifier": "u3a98",
    "page_id": "u2215",
    "page_name": "1"
   },
