# Copy to .env and fill in real values. Do not commit .env.
PORT=8000
DEBUG=True

# Production: set these on your host (e.g. Fly.io secrets), do not commit .env
AUTH_TOKEN=
SUPABASE_URL=
SUPABASE_KEY=
# Optional: for JWT verification (legacy HS256). New deployments use JWKS.
# SUPABASE_JWT_SECRET=
# Production frontend URL for CORS (e.g. https://template-checker.fly.dev)
FRONTEND_URL=
UPLOAD_FOLDER=uploads
