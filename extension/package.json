{
  "name": "frontify-template-checker-extension",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension middle-man for Frontify Template Checker",
  "scripts": {
    "build": "node scripts/copy-extension-files.js",
    "build:local": "cross-env VITE_FRONTEND_URL=http://localhost:3000 node scripts/copy-extension-files.js",
    "build:extension:local": "npm run build:local",
    "build:production": "cross-env VITE_FRONTEND_URL=https://template-checker.fly.dev node scripts/copy-extension-files.js"
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  }
}
